{
  "name": "dynamic-form-builder",
  "version": "1.0.0",
  "description": "shadcn-style CLI that copies a drag-and-drop form builder into your components directory",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "dynamic-form-builder": "./dist/cli.js",
    "dfb": "./dist/cli.js"
  },
  "files": [
    "dist",
    "registry",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "form-builder",
    "shadcn",
    "react",
    "nextjs",
    "cli",
    "ui",
    "components"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "fs-extra": "^11.3.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "next": ">=14.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "description": "Required for next/image in FormPreview"
    }
  }
}
