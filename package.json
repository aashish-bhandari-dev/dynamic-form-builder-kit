{
  "name": "dynamic-form-builder-kit",
  "version": "1.0.0",
  "description": "Production-ready, customizable drag-and-drop dynamic form builder kit built on shadcn/ui",
  "keywords": [
    "form-builder",
    "dynamic-form",
    "dynamic-form-builder",
    "shadcn",
    "shadcn-ui",
    "react",
    "nextjs",
    "cli",
    "ui",
    "components",
    "radix-ui",
    "tailwind"
  ],
  "homepage": "https://github.com/Sandezh/dynamic-form-builder#readme",
  "bugs": {
    "url": "https://github.com/Sandezh/dynamic-form-builder/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sandezh/dynamic-form-builder.git"
  },
  "license": "MIT",
  "author": "Sandesh",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dynamic-form-builder-kit": "dist/cli.js",
    "dfb": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/tests",
    "registry",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/tests/**/*.test.js",
    "prepublishOnly": "npm run test"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "fs-extra": "^11.3.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.0",
    "@types/prompts": "^2.4.9",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  }
}
